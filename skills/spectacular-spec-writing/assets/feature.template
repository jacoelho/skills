Feature: <capability>
  # Contract: <version or path>
  # Oracle: <independent decision, external contract, or justified property>
  # Boundary: <caller, API, event, or output boundary where the result is observed>
  # Evidence: proposed example | executed check <path or link>

  # Rule: needs Gherkin 6 or later; with an older runner, omit it and keep the scenario tags.
  Rule: <governing requirement ID>

    @<requirement-ID>
    Scenario: <positive or meaningful negative behaviour>
      Given <domain state>
      When <one material event>
      Then <observable result at the boundary>
      And <observable invariant or prohibited effect when relevant>

  # Question: <case whose expected result remains unresolved; do not encode it as a Then>
  # Deferred: <independent behaviour outside this increment>
